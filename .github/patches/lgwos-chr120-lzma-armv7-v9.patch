diff --git a/src/third_party/lzma_sdk/C/CpuArch.c b/src/third_party/lzma_sdk/C/CpuArch.c
--- a/src/third_party/lzma_sdk/C/CpuArch.c
+++ b/src/third_party/lzma_sdk/C/CpuArch.c
@@ -436,4 +436,13 @@
 #elif defined(MY_CPU_ARM)
-  #define MY_HWCAP_CHECK_FUNC(name) \
-  BoolInt CPU_IsSupported_ ## name() { return (getauxval(AT_HWCAP2) & (HWCAP2_ ## name)) ? 1 : 0; }
+  #if defined(__ARM_ARCH) && (__ARM_ARCH >= 8) && defined(AT_HWCAP2) && \
+      defined(HWCAP2_CRC32) && defined(HWCAP2_SHA1) && \
+      defined(HWCAP2_SHA2) && defined(HWCAP2_AES)
+    #define MY_HWCAP_CHECK_FUNC(name) \
+    BoolInt CPU_IsSupported_ ## name() { return (getauxval(AT_HWCAP2) & (HWCAP2_ ## name)) ? 1 : 0; }
+  #else
+    // LGWOS: ARMv7/Cortex-A9 has NEON in AT_HWCAP, but no ARMv8 crypto-extension HWCAP2 ABI.
+    // Keep NEON detection below intact and report ARMv8-only CRC32/SHA/AES as unavailable.
+    #define MY_HWCAP_CHECK_FUNC(name) \
+    BoolInt CPU_IsSupported_ ## name() { return 0; }
+  #endif
   MY_HWCAP_CHECK_FUNC_2(NEON, NEON)

